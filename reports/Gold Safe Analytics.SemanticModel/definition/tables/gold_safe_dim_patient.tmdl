	/// The patient's tokenised Clarity identity, populated for Clarity and Both patients
	/// and blank for Caboodle-only ones. Present so a Clarity fact can be traced back to
	/// the source record it came from without re-exposing the MRN.
	column ClarityPatientID
		dataType: string
		lineageTag: b3e07f52-8a41-4c96-a0d5-6e29b41f7c8a
		summarizeBy: none
		sourceColumn: ClarityPatientID

