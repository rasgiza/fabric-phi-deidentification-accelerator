table gold_safe_dim_patient
	lineageTag: 6afb9a93-fd73-4ec9-aa99-42600f544bcb

	measure 'Patients' = COUNTROWS ( gold_safe_dim_patient )
		formatString: #,0
		displayFolder: KPIs
		lineageTag: 2f0c1a44-6f2b-4a1e-9a5c-7b3d8e5f1c20

	/// Patients the conformed star matched across BOTH Epic-shaped sources on the shared
	/// MRN token. These are one row, not two -- so this is a subset of [Patients], never
	/// an addition to it. If this reads 0 the cross-source join silently failed.
	measure 'Patients in Both Systems' = ```
			CALCULATE (
			    COUNTROWS ( gold_safe_dim_patient ),
			    gold_safe_dim_patient[SourceSystem] = "Both"
			)
			```
		formatString: #,0
		displayFolder: KPIs
		lineageTag: 8d47e2b1-3c9a-4f60-b28e-5a1f6c0d9e33

	/// Share of patients present in both sources, measured against the smaller cohort --
	/// the same denominator gold_conform.assess_linkage() asserts against at build time.
	measure 'Cross-Source Match %' = ```
			VAR Both = [Patients in Both Systems]
			VAR InCaboodle =
			    CALCULATE (
			        COUNTROWS ( gold_safe_dim_patient ),
			        gold_safe_dim_patient[SourceSystem] IN { "Caboodle", "Both" }
			    )
			VAR InClarity =
			    CALCULATE (
			        COUNTROWS ( gold_safe_dim_patient ),
			        gold_safe_dim_patient[SourceSystem] IN { "Clarity", "Both" }
			    )
			RETURN
			    DIVIDE ( Both, MIN ( InCaboodle, InClarity ) )
			```
		formatString: 0.0%
		displayFolder: KPIs
		lineageTag: c51a9d76-0e84-4b3f-8d17-9f2c4a6b8e05

